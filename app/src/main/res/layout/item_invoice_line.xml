<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etLineDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.5"
        android:hint="@string/item_desc_header"
        android:inputType="textCapSentences"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etLineQuantity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:hint="@string/qty_hours_header"
        android:inputType="numberDecimal"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etLineRate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:gravity="end"
        android:hint="@string/rate_header"
        android:inputType="numberDecimal"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvLineTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="end"
        android:textColor="@color/teal_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnDeleteLine"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_remove_item"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/pink_accent" />

</LinearLayout>